// PC-8801mkIISR Pinball MVP sample demonstrating Aun Phase 1-3 features:
// - Hardware target definition (spaces, stack budget, bank_group, IM2 ISR, overlay_slot)
// - First-class state machine with Uchiguri state-local RAM overlay
// - Static Pool<Ball, 4> with 256-byte alignment and 1-byte Handle<Ball>
// - Fixed-point q8_8 / q10_6 physics, saturating arithmetic, and host unit tests

target pc88sr : z80 {
    space MainRam   @ 0x0100..0xBFFF;
    stack MainStack @ 0xBE00..0xBFFF;

    bank_group HighWindow @ 0xC000..0xFFFF {
        bank HighMainRam @ 0xC000..0xEFFF;
        bank VramAlu     @ 0xC000..0xFFFF requires di;
        default HighMainRam;
        switch(to) {
            HighMainRam => { io_out(0x35, 0x00); io_out(0x5F, 0x00); }
            VramAlu     => { io_out(0x35, 0x80); }
        }
    }

    interrupt_controller Pc88Int {
        disable => asm!("di");
        enable  => asm!("ei");
        source Vrtc @ im2(0xF302) { rearm => io_out(0xE4, 0x07); }
    }

    overlay_slot SceneCode @ 0x8000..0x9FFF {
        load(id: OverlayId) => hal_load_overlay(id, 0x8000);
    }
}

struct InputState {
    plunger: u8,
}

machine Ball {
    x: q10_6,
    y: q10_6,

    state Inactive;
    state InShooter { power: u8 };
    state InPlay { vx: q8_8, vy: q8_8, skill_timer: u16 };
    state MagnetHeld { hold_timer: u8 };

    transitions {
        Inactive   -> InShooter;
        InShooter  -> InPlay | Inactive;
        InPlay     -> MagnetHeld | Inactive;
        MagnetHeld -> InPlay | Inactive;
    }

    on InShooter {
        fn on_enter(&mut self) {
            self.x = 240.0q10_6;
            self.y = 180.0q10_6;
        }
        fn step(&mut self, inp: &InputState) {
            if inp.plunger == 0u8 && self.power > 0u8 {
                goto InPlay {
                    vx: 0.0q8_8,
                    vy: -2.5q8_8,
                    skill_timer: 120u16,
                };
            }
        }
    }

    on InPlay {
        fn step(&mut self, inp: &InputState) {
            // Apply gravity (saturating) and integrate position
            self.vy = self.vy +| 0.25q8_8;
            self.y = self.y + (self.vy as q10_6);
        }
    }
}

machine App {
    #[overlay(SceneCode)] state Title { cursor: u8 };
    #[overlay(SceneCode)] state Stage1 { lives: u8 };
    transitions {
        Title  -> Stage1;
        Stage1 -> Title;
    }
}

static mut VRTC_TICKS: u8 in HighMainRam;

#[layout(soa, align(256))]
static mut BALLS: Pool<Ball, 4>;

#[interrupt(Vrtc)]
fn on_vrtc() {
    VRTC_TICKS = VRTC_TICKS +% 1u8;
}

fn main() {
    let h: Handle<Ball> = BALLS.alloc(Ball::new());
    let b: &mut Ball = BALLS.get_mut(h);
    b.goto(InShooter { power: 10u8 });
    let inp: InputState = InputState { plunger: 0u8 };
    b.step(&inp);
    b.step(&inp);
    with bank(VramAlu) {
        io_out(0xFE, VRTC_TICKS_SAFE());
    }
    BALLS.free(h);
}

fn VRTC_TICKS_SAFE() -> u8 {
    1u8
}

#[test]
fn pinball_launch_and_gravity() {
    let h: Handle<Ball> = BALLS.alloc(Ball::new());
    let b: &mut Ball = BALLS.get_mut(h);
    assert!(is_state!(b, Ball::Inactive));

    b.goto(InShooter { power: 10u8 });
    assert!(is_state!(b, Ball::InShooter));
    assert!(b.y.int() == 180i16);

    let inp: InputState = InputState { plunger: 0u8 };
    b.step(&inp);
    assert!(is_state!(b, Ball::InPlay));

    b.step(&inp);
    // y started at 180.0, vy became -2.5 + 0.25 = -2.25 => y = 177.75 -> floor int = 177
    assert!(b.y.int() == 177i16);

    BALLS.free(h);
}
